# Compose already supplies these values. Copy this file only for host-side commands.
PLATFORM_OIDC_ISSUER=http://localhost:8081/realms/platform
PLATFORM_OIDC_JWKS_URL=http://localhost:8081/realms/platform/protocol/openid-connect/certs
PLATFORM_OIDC_AUDIENCE=cluster-platform
PLATFORM_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform
PLATFORM_RABBITMQ_URL=amqp://platform:platform@localhost:5672//
PLATFORM_MANAGEMENT_CLUSTER=local-mgmt
