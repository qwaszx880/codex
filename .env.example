# Copy this file to .env. Set PLATFORM_PUBLIC_HOST to the IP address or DNS name that
# browsers use to reach the machine running Compose. PLATFORM_BIND_ADDRESS controls
# which host interface receives published ports; 0.0.0.0 allows access from a VM host.
PLATFORM_PUBLIC_HOST=localhost
PLATFORM_BIND_ADDRESS=0.0.0.0

# These values are examples for host-side commands. When changing
# PLATFORM_PUBLIC_HOST, update the two public OIDC URLs below to the same host.
PLATFORM_OIDC_ISSUER=http://localhost:8081/realms/platform
PLATFORM_OIDC_JWKS_URL=http://localhost:8081/realms/platform/protocol/openid-connect/certs
PLATFORM_OIDC_AUDIENCE=cluster-platform
PLATFORM_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform
PLATFORM_RABBITMQ_URL=amqp://platform:platform@localhost:5672//
PLATFORM_MANAGEMENT_CLUSTER=local-mgmt
